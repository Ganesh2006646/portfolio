{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "functions": {
    "api/chat.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/log-visitor.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/log-visitor", "destination": "/api/log-visitor" }
  ]
}
